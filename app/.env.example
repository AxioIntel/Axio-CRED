PORT=8080
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
APP_URL=http://localhost:5173
DATA_MODE=demo
MYSQL_URL=mysql://axiocred_app:CHANGE_ME@127.0.0.1:3306/axiocred_dev
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
GOOGLE_MAPS_API_KEY=placeholder
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=placeholder
PAYPAL_CLIENT_SECRET=placeholder
# Optional merchant account reference; not a replacement for client credentials.
PAYPAL_MERCHANT_ID=placeholder
PAYPAL_PRODUCT_ID=placeholder
PAYPAL_BUSINESS_PLAN_ID=placeholder
PAYPAL_GROWTH_PLAN_ID=placeholder
# ID returned after registering https://YOUR_BACKEND/api/webhooks/paypal
# in the same REST app/environment as the client credentials above.
PAYPAL_WEBHOOK_ID=placeholder
ENTERPRISE_API_KEY=placeholder-change-to-a-long-random-key

# Verified Google email allowed to bootstrap and administer the reporting team
REPORTING_OWNER_EMAIL=

# Choose openai or azure. Azure uses the deployment name, not the model catalog ID.
AI_PROVIDER=openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Outscraper fallback: storing a key alone NEVER enables paid collection.
# https://docs.outscraper.com/endpoints/google-maps-reviews/
OUTSCRAPER_API_KEY=
OUTSCRAPER_ENABLED=false
# Set a positive monthly allowance AND enable explicitly after approving spend.
OUTSCRAPER_MONTHLY_REVIEW_LIMIT=0
OUTSCRAPER_MAX_REVIEWS_PER_JOB=2000
